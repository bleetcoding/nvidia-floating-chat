package __PACKAGE__;

import android.app.RemoteInput;
import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.os.Bundle;

public class FloatingAIReplyReceiver extends BroadcastReceiver {
  @Override public void onReceive(Context context, Intent intent) {
    if (intent == null) return;
    if (FloatingNotificationAssistant.ACTION_LEAVE.equals(intent.getAction())) { FloatingNotificationAssistant.leave(context); return; }
    if (!FloatingNotificationAssistant.ACTION_REPLY.equals(intent.getAction())) return;
    Bundle results = RemoteInput.getResultsFromIntent(intent); CharSequence reply = results == null ? null : results.getCharSequence(FloatingNotificationAssistant.EXTRA_REPLY);
    if (reply != null && reply.length() > 0) FloatingNotificationAssistant.reply(context, reply.toString());
  }
}
