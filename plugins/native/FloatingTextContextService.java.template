package __PACKAGE__;

import android.accessibilityservice.AccessibilityService;
import android.content.SharedPreferences;
import android.os.Build;
import android.os.Bundle;
import android.provider.Settings;
import android.view.accessibility.AccessibilityEvent;
import android.view.accessibility.AccessibilityNodeInfo;
import java.util.HashSet;

public class FloatingTextContextService extends AccessibilityService {
  private static FloatingTextContextService active;
  private static AccessibilityNodeInfo focused;
  private static String activePackage = "";

  @Override public void onServiceConnected() { active = this; }
  @Override public void onAccessibilityEvent(AccessibilityEvent event) {
    if (event == null || event.getPackageName() == null) return;
    activePackage = event.getPackageName().toString();
    if (getPackageName().contentEquals(event.getPackageName())) return;
    if (excluded(event.getPackageName())) { clearFocused(); return; }
    AccessibilityNodeInfo source = event.getSource();
    if (source == null) return;
    AccessibilityNodeInfo candidate = source.isEditable() ? source : source.findFocus(AccessibilityNodeInfo.FOCUS_INPUT);
    if (candidate != null && candidate.isEditable() && !sensitive(candidate)) {
      if (focused != null) focused.recycle();
      focused = AccessibilityNodeInfo.obtain(candidate);
    }
    if (candidate != null && candidate != source) candidate.recycle();
    source.recycle();
  }
  @Override public void onInterrupt() { }
  @Override public void onDestroy() { active = null; if (focused != null) { focused.recycle(); focused = null; } super.onDestroy(); }

  public static boolean enabled(android.content.Context context) {
    String value = Settings.Secure.getString(context.getContentResolver(), Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES);
    return value != null && value.contains(context.getPackageName() + "/." + FloatingTextContextService.class.getSimpleName());
  }
  public static String activePackage() { return activePackage; }

  public static String visibleText(int limit) {
    if (active == null) return "";
    AccessibilityNodeInfo root = active.getRootInActiveWindow();
    if (root == null) return "";
    if (excluded(root.getPackageName())) { root.recycle(); return ""; }
    StringBuilder output = new StringBuilder();
    collect(root, output, new HashSet<String>(), limit);
    root.recycle();
    return output.toString().trim();
  }

  private static void collect(AccessibilityNodeInfo node, StringBuilder output, HashSet<String> seen, int limit) {
    if (node == null || output.length() >= limit) return;
    if (node.isVisibleToUser() && !sensitive(node) && node.getText() != null) {
      String text = node.getText().toString().trim();
      if (!text.isEmpty() && seen.add(text)) {
        if (output.length() > 0) output.append(" ");
        output.append(text);
      }
    }
    for (int i = 0; i < node.getChildCount() && output.length() < limit; i++) {
      AccessibilityNodeInfo child = node.getChild(i);
      if (child != null) { collect(child, output, seen, limit); child.recycle(); }
    }
  }

  public static boolean replace(String value) {
    AccessibilityNodeInfo target = currentEditable();
    if (target == null || sensitive(target) || excluded(target.getPackageName())) return false;
    Bundle args = new Bundle();
    args.putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, value);
    boolean applied = target.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args);
    target.recycle();
    return applied;
  }

  public static boolean insert(String value) {
    AccessibilityNodeInfo target = currentEditable();
    if (target == null || sensitive(target) || excluded(target.getPackageName())) return false;
    String current = target.getText() == null ? "" : target.getText().toString();
    Bundle args = new Bundle();
    args.putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, current + (current.isEmpty() ? "" : " ") + value);
    boolean applied = target.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, args);
    target.recycle();
    return applied;
  }

  private static boolean sensitive(AccessibilityNodeInfo node) {
    return node.isPassword() || (Build.VERSION.SDK_INT >= 34 && node.isAccessibilityDataSensitive());
  }

  private static void clearFocused() { if (focused != null) { focused.recycle(); focused = null; } }
  private static boolean excluded(CharSequence packageName) {
    if (active == null || packageName == null) return false;
    SharedPreferences prefs = active.getSharedPreferences("floating_bubble", 0);
    if (!prefs.getBoolean("contextExclusionsEnabled", false)) return false;
    String target = packageName.toString().trim();
    for (String item : prefs.getString("contextExcludedPackages", "").split("[,\\n\\r\\s]+")) if (!item.trim().isEmpty() && target.equalsIgnoreCase(item.trim())) return true;
    return false;
  }
  private static AccessibilityNodeInfo currentEditable() {
    if (active == null) return null;
    AccessibilityNodeInfo root = active.getRootInActiveWindow();
    if (root != null) {
      AccessibilityNodeInfo fresh = root.findFocus(AccessibilityNodeInfo.FOCUS_INPUT);
      root.recycle();
      if (fresh != null && fresh.isEditable()) return fresh;
      if (fresh != null) fresh.recycle();
    }
    if (focused != null && focused.isEditable()) return AccessibilityNodeInfo.obtain(focused);
    return null;
  }
}
