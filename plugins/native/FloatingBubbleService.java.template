public class FloatingBubbleService extends Service {
  private static final String CHANNEL_ID = "floating_chat_channel";
  private static final int NOTIFICATION_ID = 742;
  private static final String ACTION_REFRESH = "__PACKAGE__.REFRESH_FLOATING_BUBBLE";
  private final Handler main = new Handler(Looper.getMainLooper());
  private final ExecutorService worker = Executors.newSingleThreadExecutor();
  private WindowManager manager;
  private TextView bubble;
  private LinearLayout panel;
  private LinearLayout transcript;
  private ScrollView transcriptScroll;
  private EditText composer;
  private TextView status;
  private WindowManager.LayoutParams bubbleParams;
  private WindowManager.LayoutParams panelParams;
  private String panelLayoutKey = "default";
  private TextToSpeech textToSpeech;
  private SpeechRecognizer recognizer;
  private boolean ttsReady;
  private String latestAnswer = "";

  @Override public void onCreate() {
    super.onCreate();
    createChannel();
    textToSpeech = new TextToSpeech(this, code -> ttsReady = code == TextToSpeech.SUCCESS);
    startForeground(NOTIFICATION_ID, notification());
    showBubble();
  }

  @Override public int onStartCommand(Intent intent, int flags, int startId) {
    if (intent != null && ACTION_REFRESH.equals(intent.getAction())) {
      if (bubble != null) { manager.removeView(bubble); bubble = null; showBubble(); }
      if (panel != null) { removePanel(); showPanel(); }
    }
    return START_STICKY;
  }

  private Notification notification() {
    Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse("__SCHEME__://chat"));
    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
    PendingIntent open = PendingIntent.getActivity(this, 0, intent, PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
    return new Notification.Builder(this, CHANNEL_ID).setContentTitle("Floating AI is active").setContentText("Tap the bubble for contextual responses").setSmallIcon(getApplicationInfo().icon).setContentIntent(open).setOngoing(true).build();
  }

  private void createChannel() {
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
      NotificationChannel channel = new NotificationChannel(CHANNEL_ID, "Floating AI", NotificationManager.IMPORTANCE_LOW);
      channel.setDescription("Required while the user-controlled Floating AI panel is enabled");
      ((NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE)).createNotificationChannel(channel);
    }
  }

  private int overlayType() { return Build.VERSION.SDK_INT >= Build.VERSION_CODES.O ? WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY : WindowManager.LayoutParams.TYPE_PHONE; }
  private int dp(int value) { return (int) (value * getResources().getDisplayMetrics().density + .5f); }
  private android.content.SharedPreferences prefs() { return getSharedPreferences("floating_bubble", 0); }
  private String layoutKey() { String packageName = prefs().getBoolean("perAppLayoutsEnabled", false) ? FloatingTextContextService.activePackage() : ""; if (packageName == null || packageName.trim().isEmpty()) return "default"; return packageName.replaceAll("[^A-Za-z0-9._-]", "_"); }
  private int layoutInt(String name, int fallback) { return prefs().getInt("layout." + panelLayoutKey + "." + name, fallback); }
  private GradientDrawable rounded(int color, int radius) { GradientDrawable drawable = new GradientDrawable(); drawable.setColor(color); drawable.setCornerRadius(dp(radius)); drawable.setStroke(dp(1), Color.rgb(44, 58, 48)); return drawable; }
  private TextView text(String value, int color, float size, boolean bold) { TextView view = new TextView(this); view.setText(value); view.setTextColor(color); view.setTextSize(size); if (bold) view.setTypeface(Typeface.DEFAULT_BOLD); return view; }
  private TextView button(String value, int color) { TextView view = text(value, Color.rgb(241, 247, 240), 12, true); view.setGravity(Gravity.CENTER); view.setBackground(rounded(color, 12)); view.setPadding(dp(7), 0, dp(7), 0); return view; }

  private void showBubble() {
    manager = (WindowManager) getSystemService(WINDOW_SERVICE);
    bubble = text("AI", Color.rgb(8, 16, 0), 15, true); bubble.setGravity(Gravity.CENTER);
    GradientDrawable fill = new GradientDrawable(); fill.setShape(GradientDrawable.OVAL); fill.setColor(Color.parseColor(prefs().getString("color", "#76B900"))); fill.setStroke(dp(2), Color.rgb(181, 232, 83)); bubble.setBackground(fill);
    int size = dp(prefs().getInt("sizeDp", 58));
    bubbleParams = new WindowManager.LayoutParams(size, size, overlayType(), WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS, PixelFormat.TRANSLUCENT);
    bubbleParams.gravity = Gravity.TOP | Gravity.START; bubbleParams.x = dp(18); bubbleParams.y = dp(220);
    bubble.setOnTouchListener(new View.OnTouchListener() {
      private float rawX; private float rawY; private int startX; private int startY; private boolean dragged;
      @Override public boolean onTouch(View view, MotionEvent event) {
        if (event.getAction() == MotionEvent.ACTION_DOWN) { rawX = event.getRawX(); rawY = event.getRawY(); startX = bubbleParams.x; startY = bubbleParams.y; dragged = false; return true; }
        if (event.getAction() == MotionEvent.ACTION_MOVE) { float dx = event.getRawX() - rawX; float dy = event.getRawY() - rawY; dragged = Math.abs(dx) > dp(6) || Math.abs(dy) > dp(6); bubbleParams.x = startX + (int) dx; bubbleParams.y = startY + (int) dy; manager.updateViewLayout(bubble, bubbleParams); return true; }
        if (event.getAction() == MotionEvent.ACTION_UP) { if (!dragged) showPanel(); return true; }
        return false;
      }
    });
    manager.addView(bubble, bubbleParams);
  }

  private void showPanel() {
    if (panel != null || manager == null) return;
    panelLayoutKey = layoutKey();
    panel = new LinearLayout(this); panel.setOrientation(LinearLayout.VERTICAL); panel.setPadding(dp(13), dp(11), dp(13), dp(11)); panel.setAlpha(Math.max(.55f, Math.min(1f, prefs().getFloat("panelOpacity", .96f)))); panel.setBackground(rounded(Color.rgb(12, 26, 22), 18));
    LinearLayout header = new LinearLayout(this); header.setGravity(Gravity.CENTER_VERTICAL);
    TextView title = text(prefs().getString("overlayTitle", "Floating AI Chat"), Color.rgb(242,247,241), 15, true); title.setSingleLine(true); title.setContentDescription("Drag floating assistant window"); installMoveHandle(title); header.addView(title, new LinearLayout.LayoutParams(0, dp(34), 1));
    TextView close = text("×", Color.rgb(181,232,83), 28, false); close.setGravity(Gravity.CENTER); close.setContentDescription("Close floating assistant"); close.setOnClickListener(v -> removePanel()); header.addView(close, new LinearLayout.LayoutParams(dp(34), dp(34))); panel.addView(header);
    TextView privacy = text(prefs().getBoolean("contextEnabled", false) ? "Visible text is used only after you tap an action." : "Screen text is off. Enable it in Configuration if you want context.", Color.rgb(154,168,155), 10, false); privacy.setPadding(0, 0, 0, dp(7)); panel.addView(privacy);
    transcriptScroll = new ScrollView(this); transcript = new LinearLayout(this); transcript.setOrientation(LinearLayout.VERTICAL); transcriptScroll.addView(transcript); addEntry("Context", prefs().getString("overlayExcerpt", "Type a message or choose an action to begin.")); panel.addView(transcriptScroll, new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 1));
    LinearLayout statusRow = new LinearLayout(this); statusRow.setGravity(Gravity.CENTER_VERTICAL); status = text("", Color.rgb(181,232,83), 11, true); status.setPadding(0, dp(6), 0, dp(4)); statusRow.addView(status, new LinearLayout.LayoutParams(0, dp(29), 1)); TextView resize = text("◢", Color.rgb(181,232,83), 16, true); resize.setGravity(Gravity.CENTER); resize.setContentDescription("Resize floating assistant window"); installResizeHandle(resize); statusRow.addView(resize, new LinearLayout.LayoutParams(dp(30), dp(29))); panel.addView(statusRow);
    LinearLayout compose = new LinearLayout(this); compose.setGravity(Gravity.BOTTOM);
    composer = new EditText(this); composer.setTextColor(Color.rgb(242,247,241)); composer.setTextSize(13); composer.setHintTextColor(Color.rgb(143,157,145)); composer.setHint("Ask or type a reply…"); composer.setMaxLines(3); composer.setContentDescription("Floating assistant message input"); composer.setBackground(rounded(Color.rgb(24,36,30), 13)); composer.setPadding(dp(10), dp(5), dp(10), dp(5)); compose.addView(composer, new LinearLayout.LayoutParams(0, dp(48), 1));
    if (prefs().getBoolean("voiceEnabled", false)) { TextView mic = button("Mic", Color.rgb(35,60,30)); mic.setContentDescription("Speak a prompt"); mic.setOnClickListener(v -> startVoice()); LinearLayout.LayoutParams micParams = new LinearLayout.LayoutParams(dp(48), dp(48)); micParams.setMargins(dp(6), 0, 0, 0); compose.addView(mic, micParams); }
    TextView ask = button("Ask", Color.rgb(118,185,0)); ask.setTextColor(Color.rgb(8,16,0)); ask.setContentDescription("Ask floating assistant"); ask.setOnClickListener(v -> request("ask")); LinearLayout.LayoutParams askParams = new LinearLayout.LayoutParams(dp(52), dp(48)); askParams.setMargins(dp(6), 0, 0, 0); compose.addView(ask, askParams); panel.addView(compose);
    LinearLayout response = new LinearLayout(this); response.setGravity(Gravity.CENTER_VERTICAL); response.setPadding(0, dp(7), 0, 0); addResponseAction(response, "Replace latest response", () -> replace()); if (prefs().getBoolean("voiceEnabled", false)) addResponseAction(response, "Speak latest response", () -> speak()); panel.addView(response);
    int height = Math.max(300, Math.min(560, layoutInt("height", prefs().getInt("panelHeightDp", 380))));
    int width = Math.max(280, Math.min(420, layoutInt("width", prefs().getInt("panelWidthDp", 344))));
    panelParams = new WindowManager.LayoutParams(dp(width), dp(height), overlayType(), WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS, PixelFormat.TRANSLUCENT);
    panelParams.gravity = Gravity.TOP | Gravity.START; panelParams.x = layoutInt("x", prefs().getInt("panelX", Math.max(dp(8), getResources().getDisplayMetrics().widthPixels - dp(width) - dp(12)))); panelParams.y = layoutInt("y", prefs().getInt("panelY", dp(82))); panelParams.softInputMode = WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE; clampPanelPosition(); manager.addView(panel, panelParams); scrollBottom();
  }

  private void addQuick(LinearLayout row, String label, String mode) { TextView item = button(label, Color.rgb(35,60,30)); item.setContentDescription(label + " with screen context"); item.setOnClickListener(v -> request(mode)); LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(0, dp(42), 1); if (row.getChildCount() > 0) params.setMargins(dp(6), 0, 0, 0); row.addView(item, params); }
  private void addResponseAction(LinearLayout row, String label, Runnable action) { TextView item = text(label, Color.rgb(181,232,83), 11, true); item.setGravity(Gravity.CENTER); item.setContentDescription(label); item.setOnClickListener(v -> action.run()); row.addView(item, new LinearLayout.LayoutParams(0, dp(28), 1)); }
  private void addEntry(String author, String value) { String clean = plainOutput(value); if (clean.isEmpty() || transcript == null) return; TextView entry = text(author + "\n" + clean, Color.rgb(226,235,226), 12, false); entry.setTextIsSelectable(true); entry.setLineSpacing(dp(2), 1); entry.setBackground(rounded(Color.rgb(19,33,27), 12)); entry.setPadding(dp(10), dp(8), dp(10), dp(8)); LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT); params.setMargins(0, 0, 0, dp(7)); transcript.addView(entry, params); }
  private void setStatus(String value) { if (status != null) status.setText(value); }
  private void scrollBottom() { if (transcriptScroll != null) transcriptScroll.post(() -> transcriptScroll.fullScroll(View.FOCUS_DOWN)); }
  private String plainOutput(String value) { if (value == null) return ""; String tick = Character.toString((char) 96); String cleaned = value.replace(tick + tick + tick, "").replace(tick, "").replace("**", "").replace("__", "").replace("*", "").replace("_", "").replace("|", " ").replace("# ", ""); while (cleaned.contains("  ")) cleaned = cleaned.replace("  ", " "); return cleaned.trim(); }

  private void request(String mode) {
    String typed = composer == null ? "" : composer.getText().toString().trim();
    String visible = prefs().getBoolean("contextEnabled", false) ? FloatingTextContextService.visibleText(1400) : "";
    if (typed.isEmpty() && visible.isEmpty()) { setStatus("Type a message or enable visible screen text first."); return; }
    String task = mode.equals("rewrite") ? "Rewrite the typed text while preserving its meaning." : mode.equals("polish") ? "Improve the typed text for clarity, tone, and readability." : mode.equals("reply") ? "Draft a short, natural reply to the typed text using visible context only when helpful." : "Answer the typed request using visible context only when helpful.";
    addEntry("You", typed.isEmpty() ? "Use the visible context." : typed); setStatus("Thinking…"); scrollBottom();
    worker.execute(() -> {
      try {
        String endpoint = FloatingAIKeyboardConfig.get(this, "endpoint"); String model = FloatingAIKeyboardConfig.get(this, "model"); String apiKey = FloatingAIKeyboardConfig.get(this, "apiKey");
        if (endpoint.isEmpty() || model.isEmpty() || apiKey.isEmpty()) throw new Exception("Save a tested model in Floating AI Chat first.");
        if (!endpoint.endsWith("/chat/completions")) endpoint = endpoint.replaceAll("/+$", "") + "/chat/completions";
        JSONObject payload = new JSONObject(); payload.put("model", model); payload.put("stream", false); payload.put("max_tokens", 360); payload.put("temperature", .6);
        JSONArray messages = new JSONArray(); messages.put(new JSONObject().put("role", "system").put("content", "You are a contextual writing assistant. Personality: " + prefs().getString("personality", "Helpful, warm, concise, and practical.") + " Return only the requested response as plain text. Never use Markdown, stars, pipes, tables, headings, code fences, or decorative formatting.")); messages.put(new JSONObject().put("role", "user").put("content", task + "\nTyped text: " + (typed.isEmpty() ? "(none)" : typed) + "\nVisible text: " + (visible.isEmpty() ? "(none)" : visible))); payload.put("messages", messages);
        HttpURLConnection connection = (HttpURLConnection) new URL(endpoint).openConnection(); connection.setRequestMethod("POST"); connection.setConnectTimeout(20000); connection.setReadTimeout(30000); connection.setRequestProperty("Authorization", "Bearer " + apiKey); connection.setRequestProperty("Content-Type", "application/json"); connection.setDoOutput(true);
        try (OutputStream output = connection.getOutputStream()) { output.write(payload.toString().getBytes("UTF-8")); }
        int code = connection.getResponseCode(); BufferedReader reader = new BufferedReader(new InputStreamReader(code >= 200 && code < 300 ? connection.getInputStream() : connection.getErrorStream())); StringBuilder body = new StringBuilder(); String line; while ((line = reader.readLine()) != null) body.append(line); reader.close(); if (code < 200 || code >= 300) throw new Exception(body.toString());
        JSONObject payloadResponse = new JSONObject(body.toString()); JSONArray choices = payloadResponse.optJSONArray("choices"); JSONObject choice = choices == null ? null : choices.optJSONObject(0); JSONObject message = choice == null ? null : choice.optJSONObject("message"); String answer = message == null ? "" : plainOutput(message.optString("content", "")); if (answer.isEmpty()) throw new Exception("The selected model returned no text.");
        main.post(() -> { latestAnswer = plainOutput(answer); addEntry("AI", latestAnswer); setStatus(""); scrollBottom(); });
      } catch (Exception error) { main.post(() -> setStatus("AI request failed: " + error.getMessage())); }
    });
  }

  private void replace() { if (latestAnswer.isEmpty()) return; String clean = plainOutput(latestAnswer); if (FloatingTextContextService.replace(clean)) { removePanel(); return; } copy(); removePanel(); }
  private void insert() { if (latestAnswer.isEmpty()) return; if (FloatingTextContextService.insert(plainOutput(latestAnswer))) { removePanel(); return; } copy(); removePanel(); }
  private void copy() { if (latestAnswer.isEmpty()) return; ((ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE)).setPrimaryClip(ClipData.newPlainText("Floating AI response", plainOutput(latestAnswer))); }
  private void speak() { if (latestAnswer.isEmpty()) { setStatus("Generate a response first."); return; } if (ttsReady) { textToSpeech.stop(); textToSpeech.speak(latestAnswer, TextToSpeech.QUEUE_FLUSH, null, "floating-ai-response"); setStatus("Speaking response."); } else setStatus("Text-to-speech is not ready."); }

  private void startVoice() {
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M && checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) { setStatus("Allow microphone access in Configuration first."); return; }
    if (!SpeechRecognizer.isRecognitionAvailable(this)) { setStatus("Speech recognition is unavailable on this device."); return; }
    if (recognizer != null) recognizer.destroy();
    recognizer = Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && SpeechRecognizer.isOnDeviceRecognitionAvailable(this) ? SpeechRecognizer.createOnDeviceSpeechRecognizer(this) : SpeechRecognizer.createSpeechRecognizer(this);
    recognizer.setRecognitionListener(new RecognitionListener() {
      @Override public void onReadyForSpeech(Bundle params) { setStatus("Listening…"); }
      @Override public void onBeginningOfSpeech() { }
      @Override public void onRmsChanged(float value) { }
      @Override public void onBufferReceived(byte[] buffer) { }
      @Override public void onEndOfSpeech() { setStatus("Transcribing…"); }
      @Override public void onError(int error) { setStatus("Voice input unavailable (code " + error + ")."); }
      @Override public void onResults(Bundle results) { ArrayList<String> values = results.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION); if (values != null && !values.isEmpty() && composer != null) { String old = composer.getText().toString().trim(); composer.setText((old.isEmpty() ? "" : old + " ") + values.get(0)); composer.setSelection(composer.length()); setStatus("Voice text added. Tap Ask when ready."); } }
      @Override public void onPartialResults(Bundle values) { }
      @Override public void onEvent(int type, Bundle params) { }
    });
    Intent intent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH); intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM); intent.putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true); recognizer.startListening(intent);
  }

  private int screenWidth() { return getResources().getDisplayMetrics().widthPixels; }
  private int screenHeight() { return getResources().getDisplayMetrics().heightPixels; }
  private int clamp(int value, int minimum, int maximum) { return Math.max(minimum, Math.min(maximum, value)); }
  private void clampPanelPosition() { if (panelParams == null) return; panelParams.x = clamp(panelParams.x, 0, Math.max(0, screenWidth() - panelParams.width)); panelParams.y = clamp(panelParams.y, dp(24), Math.max(dp(24), screenHeight() - panelParams.height - dp(24))); }
  private void persistPanelLayout() { if (panelParams == null) return; int width = Math.round(panelParams.width / getResources().getDisplayMetrics().density); int height = Math.round(panelParams.height / getResources().getDisplayMetrics().density); android.content.SharedPreferences.Editor editor = prefs().edit(); if (prefs().getBoolean("perAppLayoutsEnabled", false)) editor.putInt("layout." + panelLayoutKey + ".x", panelParams.x).putInt("layout." + panelLayoutKey + ".y", panelParams.y).putInt("layout." + panelLayoutKey + ".width", width).putInt("layout." + panelLayoutKey + ".height", height); else editor.putInt("panelX", panelParams.x).putInt("panelY", panelParams.y).putInt("panelWidthDp", width).putInt("panelHeightDp", height); editor.apply(); }
  private void installMoveHandle(View handle) { handle.setOnTouchListener(new View.OnTouchListener() { private float rawX; private float rawY; private int startX; private int startY; private boolean moved; @Override public boolean onTouch(View view, MotionEvent event) { if (panelParams == null) return false; if (event.getAction() == MotionEvent.ACTION_DOWN) { rawX = event.getRawX(); rawY = event.getRawY(); startX = panelParams.x; startY = panelParams.y; moved = false; return true; } if (event.getAction() == MotionEvent.ACTION_MOVE) { float dx = event.getRawX() - rawX; float dy = event.getRawY() - rawY; moved = moved || Math.abs(dx) > dp(4) || Math.abs(dy) > dp(4); panelParams.x = startX + Math.round(dx); panelParams.y = startY + Math.round(dy); clampPanelPosition(); manager.updateViewLayout(panel, panelParams); return true; } if (event.getAction() == MotionEvent.ACTION_UP) { if (moved) { panelParams.x = panelParams.x + panelParams.width / 2 < screenWidth() / 2 ? dp(6) : Math.max(dp(6), screenWidth() - panelParams.width - dp(6)); clampPanelPosition(); manager.updateViewLayout(panel, panelParams); persistPanelLayout(); } return true; } return false; } }); }
  private void installResizeHandle(View handle) { handle.setOnTouchListener(new View.OnTouchListener() { private float rawX; private float rawY; private int startWidth; private int startHeight; @Override public boolean onTouch(View view, MotionEvent event) { if (panelParams == null) return false; if (event.getAction() == MotionEvent.ACTION_DOWN) { rawX = event.getRawX(); rawY = event.getRawY(); startWidth = panelParams.width; startHeight = panelParams.height; return true; } if (event.getAction() == MotionEvent.ACTION_MOVE) { int maxWidth = Math.min(dp(420), screenWidth() - dp(12)); int maxHeight = Math.min(dp(560), screenHeight() - dp(48)); panelParams.width = clamp(startWidth + Math.round(event.getRawX() - rawX), dp(280), Math.max(dp(280), maxWidth)); panelParams.height = clamp(startHeight + Math.round(event.getRawY() - rawY), dp(300), Math.max(dp(300), maxHeight)); clampPanelPosition(); manager.updateViewLayout(panel, panelParams); return true; } if (event.getAction() == MotionEvent.ACTION_UP) { persistPanelLayout(); return true; } return false; } }); }
  private void removePanel() { if (panel != null && manager != null) { manager.removeView(panel); panel = null; panelParams = null; transcript = null; transcriptScroll = null; composer = null; status = null; } }
  @Override public void onDestroy() { if (recognizer != null) recognizer.destroy(); if (textToSpeech != null) { textToSpeech.stop(); textToSpeech.shutdown(); } worker.shutdownNow(); if (bubble != null && manager != null) manager.removeView(bubble); removePanel(); super.onDestroy(); }
  @Override public IBinder onBind(Intent intent) { return null; }
}
